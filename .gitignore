# 依赖 / 构建产物
node_modules/
dist/
dist-cjs/
*.tsbuildinfo

# 运行时日志 / 抓包 / 派生资源（都可重建，不进版本库）
logs/
data/logs/
data/capture/
# saveSave() 的原子写中间文件与坏档回退副本（save.json 本身入库）
data/*.tmp
data/*.bak

# 杂项
__pycache__/
*.pyc
*.log
.DS_Store

# frp 隧道凭据(auth.token), 永不入库
frpc-sld.toml
frida/frpc-sld.toml

# 安卓工程: 工具链与本地产物都不入库(libnode.so / 13MB 整表产物 / 解出来的 seed)
.gradle/
android/**/build/
android/**/.cxx/
android/local.properties
android/app/libnode/
android/app/src/main/jniLibs/**/*.so
# 规则按模块通配: :probe 与 :app 的 assets/code(13MB 整表) 与 assets/seed 都由 pack_nodejs 现铺
android/*/src/main/assets/code/
android/*/src/main/assets/seed/
apk/
