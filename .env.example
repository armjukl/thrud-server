# 斯露德(Thrud/sld) 假服启动参数。命令行/环境变量同名参数优先, 这里只填"没给"的键。
# 用法: cp .env.example .env 然后按需改。列表项用英文逗号分隔。

# ---- 监听 ----
# BIND=0.0.0.0
SLD_HTTP_PORT=9443
SLD_KCP_PORT=19005
# 1 = HTTP 侧起 TLS(https), 需要 certs/server.{crt,key}
SLD_TLS=1
# kcp | raw | auto (auto = 首个数据报像 KCP 就走 KCP)
SLD_NET_MODE=auto

# ---- 下发地址 ----
# 下发给客户端的公网地址(serverUrlData / 服务器列表); 手机侧靠它回连。
SLD_PUBLIC_HOST=23.147.232.29
# 局域网回连地址(服务器列表 ip/host); 留空回环
# SLD_LAN_IP=127.0.0.1

# ---- 版本 ----
# resVersion 硬编码在 src/config.ts (1583) = 手机资源包 kvl.kvl 的 ResVersion;
# 服务端报同值 -> 客户端判定无需更新, 不走热更(没有 SLD_RESVER / SLD_HOTUPDATE 了).

# ---- APK 路径(留空用代码默认: <项目根>/../res/apk/...) ----
# 仅工具链/selftest 取 metadata 用, 假服运行不需要
# SLD_APK=

# ---- 身份 ----
# SLD_LINE=1
# SLD_SERVER=10001

# ---- 日志 ----
# debug | info | warn | error
# SLD_LOG_LEVEL=info
# 1 = 关闭彩色输出
# SLD_NO_COLOR=1
